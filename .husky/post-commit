      npm --prefix "$ai_config_dir" run --silent git:hook -- post-commit "$PWD" "$@" || true
    else
      echo "ai-config: $ai_config_dir is missing, so this repository's shared AI setup is not kept current. Clone ai-config next to the main checkout (see its README)." >&2
    fi
  fi
) </dev/null || true
