(
  if [ -n "${AI_CONFIG_WORKSPACE_PULL:-}" ]; then
    :
  elif ! common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || [ -z "$common_dir" ]; then
